---
import Base from "../layouts/Base.astro";
---

<Base
  title="Página no encontrada | Mundo Gamer"
  description="La página que buscás no existe. Volvé al inicio."
  currentRoute="/"
>
  <section class="seccion">
    <div class="contenedor texto-centrado">
      <p class="titulo-404">404</p>
      <h2 class="titulo-seccion">Esta página no existe</h2>
      <p class="subtitulo-seccion">
        Parece que el producto que buscás se fue de viaje.
      </p>
      <a class="boton boton--primario boton--grande" href="/">
        Volver al inicio
      </a>
    </div>
  </section>
</Base>