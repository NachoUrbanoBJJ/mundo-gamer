---
interface Slide {
  imagen: string;
  alt: string;
  badge?: string;
  titulo?: string;
  cta?: { etiqueta: string; enlace: string };
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<div class="carousel" data-carousel>
  <div class="carousel__track" data-carousel-track>
    {
      slides.map(({ imagen, alt, badge, titulo, cta }, indice) => {
        const imagenMovil = imagen.replace(/\.jpg$/, "-960w.jpg");
        return (
        <div
          class="carousel__diapositiva"
          id={`carousel-diapositiva-${indice + 1}`}
          inert={indice !== 0 ? "true" : undefined}
          aria-hidden={indice !== 0 ? "true" : "false"}
        >
          <img
            class="carousel__slide"
            src={imagen}
            srcset={`${imagenMovil} 960w, ${imagen} 1920w`}
            sizes="100vw"
            alt={alt}
            width="1920"
            height="576"
            decoding="async"
            fetchpriority={indice === 0 ? "high" : undefined}
          />
          <div class="carousel__contenido">
            <div class="carousel__interno">
              {badge && <span class="carousel__badge">{badge}</span>}
              {titulo && <h2 class="carousel__titulo">{titulo}</h2>}
              {cta && (
                <a class="boton boton--grande" href={cta.enlace}>
                  {cta.etiqueta}
                </a>
              )}
            </div>
          </div>
        </div>
        );
      })
    }
  </div>

  <button
    class="carousel__boton carousel__boton--anterior"
    type="button"
    data-carousel-anterior
    aria-label="Imagen anterior"
  >
    &lsaquo;
  </button>
  <button
    class="carousel__boton carousel__boton--siguiente"
    type="button"
    data-carousel-siguiente
    aria-label="Imagen siguiente"
  >
    &rsaquo;
  </button>

  <div class="carousel__puntos" data-carousel-puntos role="tablist" aria-label="Seleccionar imagen"></div>
</div>

<script>
  const carrusel = document.querySelector("[data-carousel]");
  if (carrusel) {
    const iniciar = () => {
    const track = carrusel.querySelector<HTMLElement>("[data-carousel-track]");
    const botonAnterior = carrusel.querySelector<HTMLButtonElement>("[data-carousel-anterior]");
    const botonSiguiente = carrusel.querySelector<HTMLButtonElement>("[data-carousel-siguiente]");
    const contenedorPuntos = carrusel.querySelector<HTMLElement>("[data-carousel-puntos]");
    if (!track || !botonAnterior || !botonSiguiente || !contenedorPuntos) return;
    const total = track.children.length;
    let indice = 0;

    const puntos: HTMLButtonElement[] = [];
    for (let i = 0; i < total; i += 1) {
      const punto = document.createElement("button");
      punto.type = "button";
      punto.setAttribute("role", "tab");
      punto.setAttribute("id", `carousel-punto-${i + 1}`);
      punto.setAttribute("aria-controls", `carousel-diapositiva-${i + 1}`);
      punto.setAttribute("aria-label", `Ir a la imagen ${i + 1}`);
      punto.addEventListener("click", () => moverA(i));
      contenedorPuntos.appendChild(punto);
      puntos.push(punto);
    }

    function actualizar() {
      track!.style.transform = `translateX(-${indice * 100}%)`;
      Array.from(track!.children).forEach((diapositiva, i) => {
        const elemento = diapositiva as HTMLElement;
        elemento.classList.toggle("activo", i === indice);
        elemento.inert = i !== indice;
        elemento.setAttribute("aria-hidden", i === indice ? "false" : "true");
      });
      puntos.forEach((punto, i) => {
        punto.classList.toggle("activo", i === indice);
        punto.setAttribute("aria-selected", String(i === indice));
        punto.setAttribute("tabindex", i === indice ? "0" : "-1");
      });
    }

    function moverA(nuevoIndice: number) {
      indice = (nuevoIndice + total) % total;
      actualizar();
      reiniciarAvanzador();
    }

    let avanzador: number | null = null;

    function reiniciarAvanzador() {
      if (avanzador) window.clearInterval(avanzador);
      avanzador = window.setInterval(() => moverA(indice + 1), 5000);
    }

    botonAnterior.addEventListener("click", () => moverA(indice - 1));
    botonSiguiente.addEventListener("click", () => moverA(indice + 1));

    carrusel.addEventListener("pointerenter", () => {
      if (avanzador) window.clearInterval(avanzador);
    });
    carrusel.addEventListener("pointerleave", reiniciarAvanzador);

    actualizar();
    reiniciarAvanzador();
    };
    iniciar();
  }
</script>
