---
interface Props {
  items: string[];
}

const { items } = Astro.props;

const pista = [...items, ...items];
---

<div class="marquesina" aria-hidden="true">
  <div class="marquesina__pista">
    {
      pista.map((item, index) => (
        <span class="marquesina__item" key={index}>
          {item}
        </span>
      ))
    }
  </div>
</div>